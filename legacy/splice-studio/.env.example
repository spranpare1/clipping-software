# API and local storage
PORT=3001
DATA_DIR=./data
# Local disk, reverse proxy, and provider limits apply unless this is set.
# MAX_UPLOAD_BYTES=53687091200
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_PRESET=veryfast

# Direct RTMP ingest for your own OBS/encoder streams.
# Open/forward this TCP port only on a trusted network. LIVE_RTMP_HOST is the
# address shown in OBS (localhost on this computer, or its LAN/public hostname).
LIVE_RTMP_BIND=0.0.0.0
LIVE_RTMP_HOST=localhost
LIVE_RTMP_PORT=1935

# Optional speech transcription. Key is used only by the server.
# OPENAI_API_KEY=
# OPENAI_TRANSCRIPTION_MODEL=whisper-1

# YouTube Data API OAuth. Register this callback in Google OAuth settings.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/oauth/youtube/callback

# TikTok Login Kit + Content Posting API. Callback must be HTTPS and registered.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://your-public-host.example/api/oauth/tiktok/callback

# Twitch source OAuth for downloading Twitch Clip links (not full VODs).
# Register this exact callback URI in your Twitch developer application.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_REDIRECT_URI=http://localhost:3001/api/oauth/twitch/callback

# Google Data Portability API: import your own published YouTube video files.
# This requires API enablement and Google OAuth app verification for production.
# GOOGLE_DATA_PORTABILITY_API_KEY=
# GOOGLE_DATA_PORTABILITY_REDIRECT_URI=http://localhost:3001/api/oauth/youtube-source/callback
# GOOGLE_PORTABILITY_POLL_MS=30000

# Required to connect any social account. Generate a long random value and back it up.
# Losing the value makes saved encrypted tokens unrecoverable.
# TOKEN_ENCRYPTION_KEY=
