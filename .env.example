# API and local storage
PORT=3001
DATA_DIR=./data
# Local disk, reverse proxy, and provider limits apply unless this is set.
# MAX_UPLOAD_BYTES=53687091200
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_PRESET=veryfast

# Optional speech transcription. Key is used only by the server.
# OPENAI_API_KEY=
# OPENAI_TRANSCRIPTION_MODEL=whisper-1

# YouTube Data API OAuth. Register this callback in Google OAuth settings.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/oauth/youtube/callback

# TikTok Login Kit + Content Posting API. Callback must be HTTPS and registered.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://your-public-host.example/api/oauth/tiktok/callback

# Required to connect any social account. Generate a long random value and back it up.
# Losing the value makes saved encrypted tokens unrecoverable.
# TOKEN_ENCRYPTION_KEY=
