# OBS > Tools > WebSocket Server Settings (OBS 28+). Keep the server local.
OBS_HOST=127.0.0.1
OBS_PORT=4455
OBS_PASSWORD=
OBS_PASSWORD_AGENT_1=
OBS_PASSWORD_AGENT_2=
OBS_PASSWORD_AGENT_3=
OBS_PASSWORD_AGENT_4=
OBS_PASSWORD_AGENT_5=

# Optional Twitch chat monitor. Create a user token with chat:read and set
# TWITCH_NICK to the account that owns that token. Do not use your client secret.
TWITCH_NICK=
TWITCH_OAUTH_TOKEN=

# Optional YouTube Live chat monitor. Use an authorized access token and the
# broadcast's liveChatId. Access tokens expire; refresh-token OAuth is a follow-up.
YOUTUBE_ACCESS_TOKEN=

# Optional live speech cues. Select openai or local-whisper. Hosted audio is sent
# only for agents where “Live speech” is explicitly enabled in the dashboard.
SPEECH_TRANSCRIPTION_PROVIDER=openai
OPENAI_API_KEY=
SPEECH_TRANSCRIPTION_MODEL=gpt-transcribe
WHISPER_CPP_PATH=
WHISPER_MODEL_PATH=

PORT=4179

# Optional custom binary paths. Otherwise ffmpeg and ffprobe must be on PATH.
FFMPEG_PATH=
FFPROBE_PATH=
